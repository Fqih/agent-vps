[Unit]
Description=Hermes agent Telegram gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=agent
WorkingDirectory=/home/agent
Environment=PATH=/home/agent/.hermes/bin:/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/agent/.local/bin/hermes gateway run
Restart=always
RestartSec=30
MemoryMax=600M

[Install]
WantedBy=multi-user.target
