# ~/.hermes/hermes.env  (read by digest.py and infobot.py)
TELEGRAM_BOT_TOKEN=     # info bot: news, alerts, read-later
TELEGRAM_CHAT_ID=       # your own chat id; every bot ignores anyone else
JOBS_BOT_TOKEN=         # jobs bot: digest, tracker, interview practice

# optional model overrides (comma-separated, tried in order after the default)
# DIGEST_FALLBACK_MODELS=ag/gemini-3.7-flash-high,gh/gpt-4.1-2025-04-14
# DIGEST_WEEKLY_MODELS=ag/gemini-3.1-pro-low,cx/gpt-6.1-sol

# Hub (hub/notify.py, hub/status.py, hub/worker.py)
NTFY_URL=http://127.0.0.1:8091
NTFY_TOKEN=             # ntfy token of the "hub" user (publisher)
STATUS_TOKEN=           # random string; the widget URL carries it as ?token=
STATUS_PUBLIC_URL=      # tailnet base URL of hub-status, used for click links
